* text=auto

# Windows 脚本保持 CRLF，避免在 macOS/Linux clone 后被改坏
*.bat text eol=crlf
*.ps1 text eol=crlf
# UTF-16 编码的 .vbs 必须按二进制处理：标成 text 会让 git 做换行符转换，直接破坏字节对齐
*.vbs binary

# 二进制素材
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.wav binary
*.m4a binary
*.mp4 binary
*.webm binary
*.ttf binary
*.otf binary
*.ttc binary
*.woff binary
*.woff2 binary
*.zip binary
